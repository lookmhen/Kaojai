# KaoJai Server Environment Configuration

# Server Port (Default: 4000)
PORT=4000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Google Gemini API Key for AI Quiz Generation
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Custom Public Domain or Static IP for QR Code (e.g. kaojai.yourcompany.com or 192.168.1.50:3000)
# If left blank, KaoJai will automatically detect the server's LAN IP address
PUBLIC_HOST=
